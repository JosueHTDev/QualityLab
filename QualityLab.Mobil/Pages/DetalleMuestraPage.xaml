<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QualityLab.Mobil.Pages.DetalleMuestraPage"
             Title="Detalle de muestra">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label x:Name="LabelCodigo" Style="{StaticResource TituloLabel}" />
            <Label x:Name="LabelTipoProducto" />
            <Label x:Name="LabelEstado" FontAttributes="Bold" TextColor="{StaticResource Primary}" />

            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray200}" Margin="0,10" />

            <Label Text="Acciones" FontAttributes="Bold" FontSize="18" />

            <Button Text="Registrar avance" Clicked="BtnRegistrarAvance_Clicked" />
            <Button Text="Registrar incidencia" Clicked="BtnRegistrarIncidencia_Clicked" BackgroundColor="{StaticResource PrimaryDark}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>