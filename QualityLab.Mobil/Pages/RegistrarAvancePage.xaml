<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QualityLab.Mobil.Pages.RegistrarAvancePage"
             Title="Registrar avance">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label x:Name="LabelMuestra" Style="{StaticResource SubtituloLabel}" />

            <Label Text="Descripción del avance" />
            <Editor x:Name="EditorDescripcion" HeightRequest="100" Placeholder="Ej. Se completó la preparación de la muestra..." />

            <Label Text="Porcentaje de avance" />
            <Slider x:Name="SliderPorcentaje" Minimum="0" Maximum="100" Value="0" ValueChanged="SliderPorcentaje_ValueChanged" />
            <Label x:Name="LabelPorcentaje" Text="0%" HorizontalOptions="Center" FontAttributes="Bold" />

            <Button Text="Guardar avance" Clicked="BtnGuardar_Clicked" Margin="0,10,0,0" />

            <Label x:Name="LabelEstadoEnvio" Style="{StaticResource SubtituloLabel}" IsVisible="False" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>