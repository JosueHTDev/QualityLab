<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QualityLab.Mobil.Pages.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource White}">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="16" VerticalOptions="Center">

            <Label Text="QualityLab" Style="{StaticResource TituloLabel}" HorizontalOptions="Center" />
            <Label Text="Acceso de técnicos" Style="{StaticResource SubtituloLabel}" HorizontalOptions="Center" Margin="0,0,0,20" />

            <Label Text="Usuario" />
            <Entry x:Name="EntryUsuario" Placeholder="Ej. tecnico1" />

            <Label Text="Contraseña" />
            <Entry x:Name="EntryPassword" Placeholder="Contraseña" IsPassword="True" />

            <Label x:Name="LabelError" Style="{StaticResource ErrorLabel}" IsVisible="False" />

            <Button x:Name="BtnIngresar" Text="Ingresar" Clicked="BtnIngresar_Clicked" Margin="0,10,0,0" />

            <ActivityIndicator x:Name="Indicador" IsRunning="False" IsVisible="False" Color="{StaticResource Primary}" />

            <Label Text="Este acceso es exclusivo para técnicos del laboratorio."
                   Style="{StaticResource SubtituloLabel}" HorizontalOptions="Center" Margin="0,20,0,0" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>